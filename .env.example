# Configurações de Produção / Desenvolvimento - Contatur Sentinela

# Porta do Servidor Node (deve coincidir com a Porta Interna do Publicador)
PORT=4015

# Ambiente
NODE_ENV=production

# URLs de Produção
PUBLIC_URL=https://sentinela.grupocontaturmkp.com.br
TRUST_PROXY=1
VITE_PUBLIC_URL=https://sentinela.grupocontaturmkp.com.br

# Banco de Dados PostgreSQL (Multi-Tenant)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sentinela?schema=public"
