# Variáveis opcionais para apps clonados deste template (frontend Vite)
# Copie para .env.local na raiz do projeto clonado.

# URL da API em produção (quando o frontend chama API em domínio separado)
# VITE_API_BASE=https://api.seu-app.contatur.com.br

# Título exibido no topbar (opcional)
# VITE_APP_TITLE=Meu App Contatur
