# Configurações de Produção / Desenvolvimento - Contatur Sentinela

# Porta do Servidor Node (deve coincidir com a Porta Interna do Publicador)
PORT=4016

# Ambiente
# Só `development` relaxa as proteções (CORS aberto, API sem token, seed).
# Qualquer outro valor — inclusive a variável ausente — aplica as regras fechadas.
NODE_ENV=production

# URLs de Produção
# Sem PUBLIC_URL definido, fora de desenvolvimento, o CORS recusa toda origem cruzada.
PUBLIC_URL=https://sentinela.grupocontaturmkp.com.br
TRUST_PROXY=1
VITE_PUBLIC_URL=https://sentinela.grupocontaturmkp.com.br

# Banco de Dados PostgreSQL (Multi-Tenant)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sentinela?schema=public"

# ---------------------------------------------------------------------------
# Tokens de serviço da API /api/*  (obrigatórios: sem nenhum deles a API
# responde 503 fora de desenvolvimento).
#
# Um token POR ESCRITÓRIO. O escopo vem do token apresentado: o `tenantId`
# enviado pelo cliente (query ou x-tenant-id) é ignorado, e a leitura e a
# escrita ficam restritas ao escritório do token.
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENTINELA_API_TOKEN_CONTATUR_SP=
SENTINELA_API_TOKEN_CONTATUR_RIO=
SENTINELA_API_TOKEN_MKP_SP=

# Token global — OPCIONAL, SOMENTE LEITURA (relatórios/monitoramento).
# Nunca grava (403 em POST/PATCH/PUT) e exige `?tenantId=` explícito de um
# escritório conhecido (contatur_sp, contatur_rio, mkp_sp). Deixe vazio se não
# houver consumidor consolidado.
SENTINELA_API_TOKEN=
